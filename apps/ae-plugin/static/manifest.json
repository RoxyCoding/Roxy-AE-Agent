{
  "id": "com.roxy.aeagent",
  "name": "Roxy AE Agent",
  "version": "0.1.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": [
    {
      "app": "aftereffects",
      "minVersion": "27.0",
      "dependencies": {
        "dvascripting": "",
        "dvauxpui": ""
      }
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "roxyPanel",
      "label": { "default": "Roxy AE Agent" },
      "title": { "default": "Roxy AE Agent" },
      "minimumSize": { "width": 240, "height": 200 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 300, "height": 360 },
      "preferredFloatingSize": { "width": 320, "height": 420 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["ws://localhost:*", "ws://127.0.0.1:*"]
    }
  }
}
