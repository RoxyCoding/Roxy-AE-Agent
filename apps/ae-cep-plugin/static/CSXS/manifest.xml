<?xml version="1.0" encoding="UTF-8"?>
<!--
  Roxy AE Agent - CEP extension for After Effects 2024 (24.x, CEP 11) to 2026 (CEP 12).
  Unsigned during development: requires PlayerDebugMode=1 (see docs/DEVELOPMENT.md).
-->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.roxy.aeagent.cep" ExtensionBundleVersion="0.1.0" ExtensionBundleName="Roxy AE Agent">
  <ExtensionList>
    <Extension Id="com.roxy.aeagent.cep.panel" Version="0.1.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[24.0,26.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.roxy.aeagent.cep.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Roxy AE Agent</Menu>
          <Geometry>
            <Size><Height>420</Height><Width>320</Width></Size>
            <MinSize><Height>200</Height><Width>240</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
